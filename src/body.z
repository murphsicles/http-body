// http-body/src/body.z — Body trait for streaming HTTP bodies
//
// Provides the Body trait that represents a streaming body
// of an HTTP request or response.
//
// Individual frames are yielded via poll_frame(), which returns
// optional Frame<Data> values. Frames can be DATA or TRAILERS.

// The Body trait represents a streaming body.
// Types implementing Body can yield data frames asynchronously.
trait Body {
    // The type of data yielded by this body
    type Data;

    // The error type this body may produce
    type Error;

    // Attempt to pull out the next frame from this body.
    // Returns Poll::Ready(Some(Ok(Frame))) when data is available,
    // Poll::Ready(None) when the body is exhausted,
    // Poll::Ready(Some(Err(e))) on error.
    fn poll_frame(self: &mut Self, cx: &mut Context) -> Poll<Option<Result<Frame<Self::Data>, Self::Error>>>;

    // Returns true when the end of stream has been reached.
    fn is_end_stream(&self) -> bool {
        return false;
    }

    // Returns bounds on the remaining length of the stream.
    fn size_hint(&self) -> SizeHint {
        return SizeHint::new();
    }
}

// ─── Poll Type ────────────────────────────────────────────────────────────

// Represents the readiness of an asynchronous operation.
enum Poll<T> {
    Ready(T),
    Pending,
}

// ─── Context Type ─────────────────────────────────────────────────────────

// Async task context (simplified for MVP).
struct Context {
    waker: i64,
}

impl Context {
    fn new() -> Context {
        return Context { waker: 0 };
    }

    fn waker(&self) -> i64 {
        return self.waker;
    }
}

// ─── Blanket Implementations ─────────────────────────────────────────────

// Body implementation for mutable references
impl<T: Body> Body for &mut T {
    type Data = T::Data;
    type Error = T::Error;

    fn poll_frame(self: &mut Self, cx: &mut Context) -> Poll<Option<Result<Frame<Self::Data>, Self::Error>>> {
        return T::poll_frame(*self, cx);
    }

    fn is_end_stream(&self) -> bool {
        return T::is_end_stream(*self);
    }

    fn size_hint(&self) -> SizeHint {
        return T::size_hint(*self);
    }
}

// Body implementation for Box<T>
impl<T: Body> Body for Box<T> {
    type Data = T::Data;
    type Error = T::Error;

    fn poll_frame(self: &mut Self, cx: &mut Context) -> Poll<Option<Result<Frame<Self::Data>, Self::Error>>> {
        return T::poll_frame(&mut **self, cx);
    }

    fn is_end_stream(&self) -> bool {
        return T::is_end_stream(&**self);
    }

    fn size_hint(&self) -> SizeHint {
        return T::size_hint(&**self);
    }
}

// Body implementation for String — yields self as a single DATA frame
impl Body for String {
    type Data = &[u8];
    type Error = i64;

    fn poll_frame(self: &mut Self, cx: &mut Context) -> Poll<Option<Result<Frame<Self::Data>, Self::Error>>> {
        if !self.is_empty() {
            let s = self;  // take ownership emulation
            // For MVP, just return the string bytes
            return Poll::Ready(Some(Result::Ok(Frame::data(s.as_bytes()))));
        }
        return Poll::Ready(None);
    }

    fn is_end_stream(&self) -> bool {
        return self.len() == 0;
    }

    fn size_hint(&self) -> SizeHint {
        return SizeHint::with_exact(self.len() as u64);
    }
}
